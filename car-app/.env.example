# Copy to .env.local for local dev. On Vercel, add these under Project Settings ▸ Environment Variables.

# Supabase ▸ Project Settings ▸ API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server only – never expose

# Gmail SMTP (Google Workspace account + App Password)
GMAIL_USER=you@yourcompany.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Public URL of this app (used in email links), no trailing slash
APP_URL=https://your-app.vercel.app

# Any long random string. Vercel sends it to the cron route automatically.
CRON_SECRET=change-me-to-a-long-random-string
